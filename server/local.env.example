# Copy this file to server/local.env (gitignored) and replace values.
# server/local.env is loaded by server/index.js + server/worker/index.js
# when NODE_ENV is not 'production'. In prod, the same shape lives at
# server/.env.

# ─── Parse Server ────────────────────────────────────────────────────────
PARSE_APP_ID=gorilla
# Generate a fresh random hex string for production. Anything will do for
# dev (this value is dev-only — never reuse in prod).
PARSE_MASTER_KEY=replace-with-random-hex-string
PARSE_DATABASE_URI=mongodb://localhost:27017/gorilla
PARSE_SERVER_URL=http://localhost:8080/api

# ─── SES adapter ─────────────────────────────────────────────────────────
# mock = writes "sent" messages to the MockSentMessage Mongo collection
#        for tests to inspect. No network, no cost, no AWS account.
# real = calls AWS SES v2 via SDK v3. Requires the AWS_* + SES_* vars below.
AWS_SES_MODE=mock

# Required when AWS_SES_MODE=real:
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SES_CONFIGURATION_SET=gorilla-production
# SES_FROM_DOMAIN=send.gorilla.email
# SES_FROM_EMAIL=noreply@send.gorilla.email

# ─── Tracking endpoints ──────────────────────────────────────────────────
# HMAC secret for tracking tokens (/t/o/:token, /t/c/:token, /u/:token) and
# any other signed token. Rotating this invalidates every outstanding tracked
# link — only rotate during planned downtime or after a leak.
# trackingTokens.js reads TRACKING_SECRET first, then legacy TRACKING_TOKEN_SECRET.
TRACKING_SECRET=dev-only-tracking-secret-replace-in-prod
TRACKING_TOKEN_SECRET=dev-only-tracking-secret-replace-in-prod
# Public base URL inserted into outbound email HTML for tracking pixel / click /
# unsubscribe links + the List-Unsubscribe header. In dev keep this as
# localhost; in prod set to https://api.gorilla.email.
PUBLIC_BASE_URL=http://localhost:3001
PUBLIC_TRACKING_BASE_URL=http://localhost:8080
