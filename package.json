{
  "name": "fe-gorilla",
  "version": "0.1.0",
  "private": true,
  "description": "A mailchimp-like email marketing platform",
  "type": "module",
  "scripts": {
    "dev": "concurrently --names server,worker,web --prefix-colors magenta,yellow,cyan --kill-others-on-fail \"node ./server/index.js\" \"node ./server/worker/index.js\" \"nuxt dev\"",
    "dev:server": "node ./server/index.js",
    "dev:worker": "node ./server/worker/index.js",
    "dev:web": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "server": "NODE_ENV=production node ./server/index.js",
    "worker": "NODE_ENV=production node ./server/worker/index.js",
    "start": "NODE_ENV=production pm2 start ./server/index.js --name gorilla && NODE_ENV=production pm2 start ./server/worker/index.js --name gorilla-worker",
    "mocks": "node ./scripts/mocks-server.cjs",
    "docs": "node ./scripts/docs-server.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:install": "playwright install --with-deps chromium",
    "demo:seed": "node scripts/demo/seed.mjs",
    "demo:capture": "node scripts/demo/seed.mjs && playwright test -c playwright.demo.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.700.0",
    "@pinia/nuxt": "^0.5.5",
    "agenda": "^5.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mjml": "^4.15.3",
    "parse": "^5.3.0",
    "parse-server": "^7.3.0",
    "pinia": "^2.2.4"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^3.14.4",
    "@playwright/test": "^1.48.0",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^8.2.2",
    "happy-dom": "^15.10.0",
    "mongodb-memory-server": "^10.1.0",
    "nuxt": "^3.13.0",
    "sass": "^1.77.0",
    "vitest": "^3.2.0"
  }
}
